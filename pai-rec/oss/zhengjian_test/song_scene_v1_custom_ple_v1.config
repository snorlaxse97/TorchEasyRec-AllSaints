train_config {
  sparse_optimizer {
    adam_optimizer {
      lr: 0.001
    }
    constant_learning_rate {
    }
  }
  dense_optimizer {
    adam_optimizer {
      lr: 0.001
    }
    constant_learning_rate {
    }
  }
  num_epochs: 1
  use_tensorboard: false
  save_checkpoints_steps: 0
}
eval_config {
}
export_config {
}
data_config {
  batch_size: 1024
  dataset_type: OdpsDataset
  label_fields: "is_click"
  label_fields: "is_valid"
  label_fields: "is_full"
  label_fields: "play_duration"
  sample_weight_fields:"is_click_weight"
  sample_weight_fields:"is_valid_weight"
  sample_weight_fields:"is_full_weight"
  sample_weight_fields:"play_duration_weight"
  num_workers: 8
  fg_mode: FG_BUCKETIZE
}
feature_configs {
  id_feature {
    feature_name: "identity_id"
    expression: "user:identity_id"
    embedding_dim: 8
    hash_bucket_size: 3700990
  }
}
feature_configs {
  id_feature {
    feature_name: "item_id"
    expression: "item:item_id"
    embedding_dim: 8
    embedding_name: "item_id_share"
    hash_bucket_size: 2368200
  }
}
feature_configs {
  id_feature {
    feature_name: "day_h"
    expression: "user:day_h"
    embedding_dim: 8
    hash_bucket_size: 240
  }
}
feature_configs {
  id_feature {
    feature_name: "week_day"
    expression: "user:week_day"
    embedding_dim: 8
    hash_bucket_size: 70
  }
}
feature_configs {
  id_feature {
    feature_name: "user_type"
    expression: "user:user_type"
    embedding_dim: 8
    hash_bucket_size: 20
  }
}
feature_configs {
  id_feature {
    feature_name: "terminal_model"
    expression: "user:terminal_model"
    embedding_dim: 8
    hash_bucket_size: 4810
  }
}
feature_configs {
  id_feature {
    feature_name: "age_group"
    expression: "user:age_group"
    embedding_dim: 8
    hash_bucket_size: 80
  }
}
feature_configs {
  id_feature {
    feature_name: "gender"
    expression: "user:gender"
    embedding_dim: 8
    hash_bucket_size: 40
  }
}
feature_configs {
  id_feature {
    feature_name: "music_vip_type"
    expression: "user:music_vip_type"
    embedding_dim: 8
    hash_bucket_size: 20
  }
}
feature_configs {
  id_feature {
    feature_name: "used_competitors_last_7d"
    expression: "user:used_competitors_last_7d"
    embedding_dim: 8
    hash_bucket_size: 100
    separator: ""
  }
}
