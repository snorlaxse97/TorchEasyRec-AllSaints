  custom_ple {
    extraction_networks {
        network_name: "layer1"
        expert_num_per_task: 2
        share_num: 2
        task_expert_net {
            hidden_units: [1024, 512, 256]
        }
        share_expert_net {
            hidden_units: [1024, 512, 256]
        }
    }
    extraction_networks {
        network_name: "layer2"
        expert_num_per_task: 3
        share_num: 3
        task_expert_net {
            hidden_units: [256, 128, 64]
        }
        share_expert_net {
            hidden_units: [256, 128, 64]
        }
    }
    extraction_networks {
        network_name: "layer3"
        expert_num_per_task: 4
        share_num: 4
        task_expert_net {
            hidden_units: [128, 64, 32]
        }
        share_expert_net {
            hidden_units: [128, 64, 32]
        }
    }
    task_towers {
        tower_name: "is_click"
        label_name: "is_click"
        sample_weight_name: "is_click_weight"
        mlp {
            hidden_units: [256, 128, 64]
        }
        losses {
            binary_cross_entropy {}
        }
        metrics {
            auc {
            }
        }
        metrics { 
          grouped_auc {
            grouping_key:  "identity_id"
          }
        }
    }
    task_towers {
        tower_name: "is_valid"
        label_name: "is_valid"
        sample_weight_name: "is_valid_weight"
        mlp {
            hidden_units: [256, 128, 64]
        }
        losses {
            binary_cross_entropy {}
        }
        metrics {
            auc {
            }
        }
        metrics {
          grouped_auc {
            grouping_key:  "identity_id"
          }
        }
    } 
    task_towers {
        tower_name: "is_full"
        label_name: "is_full"
        sample_weight_name: "is_full_weight"
        mlp {
            hidden_units: [256, 128, 64]
        }
        losses {
            binary_cross_entropy {}
        }
        metrics {
            auc {
            }
        }
        metrics { 
          grouped_auc {
            grouping_key:  "identity_id"
          }
        }
    }
    task_towers {
        tower_name: "play_duration"
        label_name: "play_duration"
        sample_weight_name: "play_duration_weight"
        mlp {
            hidden_units: [256, 128, 64]
        }
        losses {
            softmax_cross_entropy {}
        }
        num_class: 35
        metrics {
            multiclass_auc {
              thresholds: 200
              average: "weighted"
            }
        }
    }
  }
}
