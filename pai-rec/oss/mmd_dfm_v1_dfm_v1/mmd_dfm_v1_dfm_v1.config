model_config {
  feature_groups {
    group_name: "wide"
    feature_names: "identity_id"
    feature_names: "item_id"
    feature_names: "day_h"
    feature_names: "week_day"
    feature_names: "user_type"
    feature_names: "terminal_model"
    feature_names: "age_group"
    feature_names: "gender"
    feature_names: "music_vip_type"
    feature_names: "used_competitors_last_7d"
    feature_names: "singer_id"
    feature_names: "composer"
    feature_names: "lyric_writer"
    feature_names: "language_tag_id_lv2"
    feature_names: "style_tag_id_lv2"
    feature_names: "song_business_model"
    feature_names: "song_name_purified"
    group_type: WIDE
  }
  feature_groups {
    group_name: "deep"
    feature_names: "identity_id"
    feature_names: "item_id"
    feature_names: "day_h"
    feature_names: "week_day"
    feature_names: "user_type"
    feature_names: "terminal_model"
    feature_names: "age_group"
    feature_names: "gender"
    feature_names: "music_vip_type"
    feature_names: "used_competitors_last_7d"
    feature_names: "singer_id"
    feature_names: "composer"
    feature_names: "lyric_writer"
    feature_names: "language_tag_id_lv2"
    feature_names: "style_tag_id_lv2"
    feature_names: "song_business_model"
    feature_names: "song_name_purified"
    group_type: DEEP
    sequence_groups {
      group_name: "valid_play_100_seq"
      feature_names: "item_id"
      feature_names: "valid_play_100_seq__item_id"
      feature_names: "valid_play_100_seq__ts"
    }
    sequence_groups {
      group_name: "full_play_100_seq"
      feature_names: "item_id"
      feature_names: "full_play_100_seq__item_id"
      feature_names: "full_play_100_seq__ts"
    }
    sequence_encoders {
      din_encoder {
        input: "valid_play_100_seq"
        attn_mlp {
          hidden_units: 1024
          hidden_units: 512
        }
      }
    }
    sequence_encoders {
      din_encoder {
        input: "full_play_100_seq"
        attn_mlp {
          hidden_units: 1024
          hidden_units: 512
        }
      }
    }
  }
  feature_groups {
    group_name: "fm"
    feature_names: "identity_id"
    feature_names: "item_id"
    feature_names: "day_h"
    feature_names: "week_day"
    feature_names: "user_type"
    feature_names: "terminal_model"
    feature_names: "age_group"
    feature_names: "gender"
    feature_names: "music_vip_type"
    feature_names: "used_competitors_last_7d"
    feature_names: "singer_id"
    feature_names: "composer"
    feature_names: "lyric_writer"
    feature_names: "language_tag_id_lv2"
    feature_names: "style_tag_id_lv2"
    feature_names: "song_business_model"
    feature_names: "song_name_purified"
    group_type: DEEP
  }
  losses {
    binary_cross_entropy {
    }
  }
  metrics {
    auc {
    }
  }
  metrics {
    grouped_auc {
      grouping_key:  "identity_id"
    }
  }
  deepfm {
    deep {
      hidden_units: 1024
      hidden_units: 512
      hidden_units: 128
    }
    final {
      hidden_units: 1024
      hidden_units: 512
      hidden_units: 128
    }
    wide_embedding_dim: 128
  }
}
